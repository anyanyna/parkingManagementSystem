<div>
    <yt-row>
        <yt-input comkey="name" value="动态面板" type="string" v-on:changeData="change" v-on:setValue="setValue"/>
        <yt-visible comkey="isShow" :value="true" type="boolean" v-on:changeData="change" v-on:setValue="setValue"/>
        <yt-lock comkey="isLock" :value="false" type="boolean" v-on:changeData="change" v-on:setValue="setValue"/>
        <yt-value comkey="componentStates" :value='[{"label":"状态1","statusId":"1","components":{}}]' :defaultValue="[]" type="array" v-on:changeData="change" v-on:setValue="setValue"/>
    </yt-row>
    <yt-row>
        <yt-local-size comkey="positionSize" :value='{"x":"0","y":"0","w":"200","h":"200"}' :defaultValue='{"x":"0","y":"0","w":"200","h":"200"}' type="object" v-on:changeData="change" v-on:setValue="setValue"/>
    </yt-row>
    <yt-row title="不透明度">
        <yt-slider comkey="opacity" :value="1" type="number" :defaultValue="1" v-on:changeData="change" v-on:setValue="setValue"/>
    </yt-row>
    <yt-row title="选中状态" v-show="false">
        <yt-input comkey="_$$customeMutileKeys" value="componentStates" type="string"/>
    </yt-row>
    <yt-row title="状态">
        <yt-select isVariable="true" comkey="selectKey" value="1" :options='[{"label":"状态1","value":"1"}]' defaultValue="" type="string" v-on:changeData="change" v-on:setValue="setValue"></yt-select>
    </yt-row>
</div>