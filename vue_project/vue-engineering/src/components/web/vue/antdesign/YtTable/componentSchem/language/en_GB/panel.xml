    <yt-row title="data">
        <yt-spreadsheet isVariable="true" comkey="data" :value='{"columns":[{"key": "id", "title": "id", "dataIndex": "id" }, {"key": "title", "title": "title", "dataIndex": "title" }, {"key": "name", "title": "name", "dataIndex": "name" }],"dataSource":[{"id": 1, "title": "标题1", "name": "标题1"},{"id": 2, "title": "标题2", "name": "标题2"}]}' :defaultValue="{}" type="object"  v-on:changeData="change" v-on:setValue="setValue"/>
    </yt-row>
</div>