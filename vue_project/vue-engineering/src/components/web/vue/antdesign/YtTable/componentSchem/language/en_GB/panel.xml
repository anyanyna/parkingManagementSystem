            <yt-select comkey="pagePosition" value="flex-end" defaultValue="flex-end" :options='[{"label":"左对齐","value":"flex-start"},{"label":"居中对齐","value":"center"},{"label":"右对齐","value":"flex-end"}]' type="string" v-on:changeData="change" v-on:setValue="setValue"/>
        </yt-row>
